@model LegacyShop.Data.Entities.Product
@{
    ViewBag.Title = "Product details";
}
<h2>@Model.Name</h2>
<div class="details">
    <p><strong>Category:</strong> @Model.Category.Name</p>
    <p>@Model.Description</p>
    <p><strong>Price:</strong> @Model.Price.ToString("C")</p>
    <p><strong>Stock:</strong> @Model.StockQuantity</p>
    <p><strong>Active:</strong> @(Model.IsActive ? "Yes" : "No")</p>
</div>
<p>@Html.ActionLink("Edit", "Edit", new { id = Model.ProductId }) | @Html.ActionLink("Back to products", "Index")</p>
