@model LegacyShop.Data.Entities.Product
@{
    ViewBag.Title = Model.Name;
}
<h2>@Model.Name</h2>
<div class="details">
    <p><strong>Category:</strong> @Model.Category.Name</p>
    <p>@Model.Description</p>
    <p><strong>Price:</strong> @Model.Price.ToString("C")</p>
    <p><strong>Available stock:</strong> @Model.StockQuantity</p>
</div>
<p>@Html.ActionLink("Back to products", "Index")</p>
