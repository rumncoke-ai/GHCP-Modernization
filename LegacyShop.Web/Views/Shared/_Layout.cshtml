<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - LegacyShop</title>
    @Styles.Render("~/Content/css")
</head>
<body>
    <header>
        <div class="container">
            <h1>@Html.ActionLink("LegacyShop", "Index", "Home", new { area = "" }, null)</h1>
            <nav>
                @Html.ActionLink("Products", "Index", "Products", new { area = "" }, null)
                @Html.ActionLink("Categories", "Index", "Categories", new { area = "" }, null)
                @Html.ActionLink("Customers", "Index", "Customers", new { area = "" }, null)
                @Html.ActionLink("Orders", "Index", "Orders", new { area = "" }, null)
                @Html.ActionLink("Admin", "Index", "Products", new { area = "Admin" }, null)
            </nav>
        </div>
    </header>
    <main class="container">
        @RenderBody()
    </main>
    <footer class="container">
        <p>&copy; @DateTime.Now.Year LegacyShop - ASP.NET MVC 5</p>
    </footer>
    @RenderSection("scripts", required: false)
</body>
</html>
