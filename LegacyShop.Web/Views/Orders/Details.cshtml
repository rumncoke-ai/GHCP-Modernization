@model LegacyShop.Web.ViewModels.OrderDetailsViewModel
@{
    ViewBag.Title = "Order details";
}
<h2>Order #@Model.OrderId</h2>
<div class="details">
    <p><strong>Customer:</strong> @Model.CustomerName</p>
    <p><strong>Date:</strong> @Model.OrderDate.ToString("g")</p>
    <p><strong>Status:</strong> @Model.Status</p>
</div>
<h3>Items</h3>
<table>
    <thead><tr><th>Product</th><th>Quantity</th><th>Unit price</th><th>Line total</th></tr></thead>
    <tbody>
    @foreach (var item in Model.Items)
    {
        <tr>
            <td>@item.ProductName</td>
            <td>@item.Quantity</td>
            <td>@item.UnitPrice.ToString("C")</td>
            <td>@item.LineTotal.ToString("C")</td>
        </tr>
    }
    </tbody>
    <tfoot><tr><th colspan="3">Total</th><th>@Model.TotalAmount.ToString("C")</th></tr></tfoot>
</table>
<p>@Html.ActionLink("Edit status", "Edit", new { id = Model.OrderId }) | @Html.ActionLink("Back to orders", "Index")</p>
